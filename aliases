# ~/.all_aliases: sourced by ~/.zshrc and ~/.bashrc
# echo "### .all_aliases at `date`"

# Shortcut commands
alias bata="bat -A"  # All invisible characters
alias batd="bat -d"  # Diffs only
alias batp="bat -pP" # Plain, i.e. no numbers, no pager
alias catc='rg -IN "^[[:space:]]*#|^[[:space:]]*//"'
alias catn='rg -INv "^[[:space:]]*#|^[[:space:]]*//"'
alias cls='clear'
alias cpr='cp -Rp'
alias scpr='scp -rp'
alias df='df -Hl'
alias du='du -sh'
# Dump in octal and hex
alias hexd="od -t x1"
alias hexdump="hexdump -C"
# Search recent history
alias hgr='fc -lI 1 -1 | rg'
# Search recent history, return last 20 matches
hgrt() {
    fc -lI 1 -1 | rg "$@" | tail -20
}
# Search all history, sort -u matches
hgrz() {
    fc -lLn 1 -1 | rg "$@" | sort -u
}
alias ht='fc -l' # Tail history
alias more='less'
alias nv='nvim'
alias od="od -ab"
alias psx='ps -ef | head -1; ps -ef | rg'
alias sttysane='stty sane; stty iexten erase "^?" kill ^U intr ^C susp ^Z'
if type -p shfmt >/dev/null; then
    alias shf='shfmt -i 4 -s'     # Default shell format
    alias shfl='shfmt -i 4 -s -l' # List files whose formatting would change
    alias shfd='shfmt -d -i 4 -s' # Shell format with diff if file would change
    alias shff='shfmt -f'         # Recursively find shell files and print paths
fi

# shortcuts for prettier-eslint
alias pel='prettier-eslint --list-different'
alias pew='prettier-eslint --write'

# shortcuts for rg
alias rgn='rg -N'
alias rgp='rg --sort path'
alias rgpn='rg -N --sort path'

# shortcuts for shellcheck
alias sck='shellcheck $@'
alias scko='shellcheck -o all -e SC2250 $@'
alias sckf='shellcheck -x -P functions $@'

# Prompts
if [[ $LOGIN_SHELL == "bash" ]]; then
    # In bash, use these aliases to change prompts
    # Time & history number
    alias ps1-T='export PS1="${TBAR}${BE_COLOR}\t \u@\h:\! \$${NO_COLOR} "'
    # Time without history number
    alias ps1-t='export PS1="${TBAR}${BE_COLOR}\t \u@\h: \$${NO_COLOR} "'
    # Long path
    alias ps1-l='export PS1="${TBAR}${BE_COLOR}\u@\h.local:\w \$${NO_COLOR} "'
    # Short path
    alias ps1-s='export PS1="${TBAR}${BE_COLOR}\u@\h:\W \$${NO_COLOR} "'
    # No path
    alias ps1-n='export PS1="${TBAR}${BE_COLOR}\u@\h: \$${NO_COLOR} "'
    # No host
    alias ps1-0='export PS1="${TBAR}${BE_COLOR}\u: \$${NO_COLOR} "'
    # git prompt
    alias ps1-g='export PS1="${TBAR}${BE_COLOR}\t \u@\h:\W${GPROMPT}${BE_COLOR}\$${NO_COLOR} "'
else
    # Assume zsh, use these functions to change prompts
    ps1-T() { # Time & history number
        PS1='%B${prompt_color}%* %n@%m:%h $%f %b'
    }
    ps1-t() { # Time without history number
        PS1='%B${prompt_color}%* %n@%m: $%f %b'
    }
    ps1-l() { # Long path
        PS1='%B${prompt_color}%n@%m.local:%~ $%f %b'
    }
    ps1-s() { # Short path
        PS1='%B${prompt_color}%n@%m:%1~ $%f %b'
    }
    ps1-n() { # No path
        PS1='%B${prompt_color}%n@%m: $%f %b'
    }
    ps1-0() { # No host
        PS1='%B${prompt_color}%n: $%f %b'
    }
    ps1-g() { # Reset to standard git prompt
        PS1='%B${prompt_color}%* %n@%m:%1~%f $(parse_git_branch)${prompt_color}$%f %b'
    }
fi

# Kitty commands
alias ktheme='kitty +kitten themes --config-file-name themes.conf'

# TERM number of color settings
alias xt-16='export TERM=xterm'
alias xt-88='export TERM=xterm-88color'
alias xt-256='export TERM=xterm-256color'

# Directory listings
# normal
alias ls='ls $COLOR_AUTO'
alias lsa='ls -A $COLOR_AUTO'
# with special chars to indicate file type
alias l='ls -CF'
alias la='ls -AF'
# If eza is installed
if type -p eza >/dev/null; then
    alias ll='eza --git -s Name --colour=always -lg'
    alias lla='eza --git -s Name --colour=always -lga'
    # Most recent 20
    llh() {
        eza --git -s date -r --colour=always -lg "$@" | head -20
    }
    # Today only
    llt() {
        today=$(date "+%e %b")
        eza --git -s date -r --colour=always -lg "$@" | rg "$today "
    }
    alias llr='eza --git -s Name --colour=always -lgR'   # Recurse
    alias lls='eza --git -s size -r --colour=always -lg' # size
    # Dirs first, then by extension - both without & with gitignored files
    alias lw='eza --git --git-ignore --group-directories-first -s ext --colour=always -lg'
    alias lwg='eza --git --group-directories-first -s ext --colour=always -lg'
else
    alias ll='ls -l $COLOR_AUTO'
    alias lla='ls -lA $COLOR_AUTO'
    # Most recent 20
    llh() {
        ls -lt "$@" | head -20
    }
    # Today only
    llt() {
        today=$(date "+%b %e")
        ls -lt "$@" | rg " $today "
    }

    alias llr='ls -lR $COLOR_AUTO'
    alias lls='_lls' # size
    lls() {
        ls -l "$@" | rg -v ^d | sort -nr --key=5
    }
fi

