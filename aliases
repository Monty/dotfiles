# ~/dotfiles/aliases sourced by ~/.zshrc and ~/.bashrc

# Shortcut commands
alias bata="bat -A"  # All invisible characters
alias batd="bat -d"  # Diffs only
alias batp="bat -pP" # Plain, i.e. no numbers, no pager
# Use bat to format man pages
bman() {
    man "$@" | sed -u -e 's/\x1B\[[0-9;]*m//g; s/.\x08//g' |
        bat -p -lman
}
# Use bat to format help pages
# alias -g only works in zsh
if [[ $(ps -p $$ -o comm=) == "-zsh" ]]; then
    # Use bat to format -h and --help (also uses 'less')
    alias -g -- -h='-h 2>&1 | bat --language=help --style=plain'
    alias -g -- --help='--help 2>&1 | bat --language=help --style=plain'
fi
#
alias catc='rg -IN "^[[:space:]]*#|^[[:space:]]*//"'
alias catn='rg -INv "^[[:space:]]*#|^[[:space:]]*//"'
alias cls='clear'
alias decolor='sed -e "s/\x1B\[[0-9;]*m//g" -e "s/.\x08//g"'
alias cpr='cp -Rp'
alias scpr='scp -rp'
alias df='df -Hl'
alias du='du -sh'
# Dump in octal and hex
alias od="od -ab"
alias hexd="od -t x1"
alias hexdump="hexdump -C"
# Search recent history
alias hgr='fc -lI 1 -1 | rg'
# Search recent history, return last 20 matches
hgrt() {
    fc -lI 1 -1 | rg "$@" | tail -20
}
# Search all history, sort -u matches
hgrz() {
    fc -lLn 1 -1 | rg "$@" | sort -u
}
alias ht='fc -l' # Tail history
alias more='less'
alias nv='nvim'
alias psx='ps -ef | rg -v " \d{2}\.\d{2} rg " | rg'
alias sttysane='stty sane; stty iexten erase "^?" kill ^U intr ^C susp ^Z'

# shortcuts for shfmt
alias shf='shfmt -i 4 -s'     # Default shell format
alias shfl='shfmt -i 4 -s -l' # List files whose formatting would change
alias shfd='shfmt -d -i 4 -s' # Shell format with diff if file would change
alias shff='shfmt -f'         # Recursively find shell files and print paths

# shortcuts for prettier
# prettier for awk files requires node v18. Only works in $WSH
alias prc='prettier --check'
alias prw='prettier --write'

# shortcuts for eslint
pew() {
    for file in "$@"; do
        # printf "==> Processing %s\n" "${file}"
        eslint --fix "$file"
        if [[ $? -ne 1 ]]; then
            prettier --write "$file"
        fi
    done
}

# shortcuts for Python
alias ruffc='ruff check'

# shortcuts for rg
alias rgn='rg -N'
alias rgp='rg --sort path'
alias rgpn='rg -N --sort path'
alias rga="rg -N --sort path '^\/'"
alias rgaf="rg -N --sort path '^\/|^function |\(\)'"

# shortcuts for shellcheck
sck() {
    shellcheck -s bash "$@"
}
# "$XR" is defined elsewhere
# shellcheck disable=SC2154
sckd() {
    shellcheck -s bash -x -P "$XR"/functions -f diff "$@"
}
sckf() {
    shellcheck -s bash -x -P "$XR"/functions "$@"
}
scko() {
    # SC2250 Prefer always putting braces around variable references
    # SC2312 Don't pipe commands to avoid masking return values
    shellcheck -s bash -x -P "$XR"/functions -o all -e SC2250,SC2312 "$@"
}
# List files that don't pass shellcheck
sckl() {
    shellcheck -s bash -x -P "$XR"/functions "$@" |
        rg "^In" | cut -f 2 -d " " | sort -u
}

# Prompts
# Some variables are defined in .zshrc
# shellcheck disable=SC2154
# Assume zsh login, use these functions to change prompts
ps1-T() { # Time & history number
    PS1='%B${prompt_color}%* %n@%m:%h $%f %b'
}
ps1-t() { # Time without history number
    PS1='%B${prompt_color}%* %n@%m: $%f %b'
}
ps1-l() { # Long path
    PS1='%B${prompt_color}%n@%m.local:%~ $%f %b'
}
ps1-s() { # Short path
    PS1='%B${prompt_color}%n@%m:%1~ $%f %b'
}
ps1-n() { # No path
    PS1='%B${prompt_color}%n@%m: $%f %b'
}
ps1-0() { # No host
    PS1='%B${prompt_color}%n: $%f %b'
}
ps1-g() { # Reset to standard git prompt
    PS1='%B${prompt_color}%* %n@%m:%1~%f $(parse_git_branch)${prompt_color}$%f %b'
}

# Kitty commands
alias ktheme='kitty +kitten themes --config-file-name themes.conf'

# TERM number of color settings
alias xt-16='export TERM=xterm'
alias xt-88='export TERM=xterm-88color'
alias xt-256='export TERM=xterm-256color'

# Directory listings
# Short form
alias ls='ls --color=auto'
alias lsa='ls -A'
# with special chars to indicate file type
alias l='ls -CF'
alias la='ls -AF'
# Long form
alias ll='eza --git -s Name --colour=always -l'
alias lla='eza --git -s Name --colour=always -la'
# Most recent 20
llh() {
    eza --git -s old --colour=always -l "$@" | head -20
}
# Today only
llt() {
    local today
    today=$(date "+%e %b")
    eza --git -s old --colour=always -l "$@" |
        rg --color=never "$today \d{2}:\d{2}\b"
}
# Today or yesterday
ll2d() {
    local today yesterday
    today=$(date "+%e %b")
    yesterday=$(date -v-1d "+%e %b")
    eza --git -s old --color=always -l "$@" |
        rg --color=never "($today|$yesterday) \d{2}:\d{2}"
}
alias llr='eza --git -s Name --colour=always -lR'   # Recurse
alias lls='eza --git -s size -r --colour=always -l' # size
# Dirs first, then by extension - both without & with gitignored files
alias lw='eza --git --git-ignore --group-directories-first -s ext --colour=always -l'
alias lwg='eza --git --group-directories-first -s ext --colour=always -l'

