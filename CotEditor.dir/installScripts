#!/usr/bin/env bash
# Install scripts in CotEditor directory
#
# IMPORTANT: Depends on only top level scripts containing '%%%'

SCRIPTDIR="$HOME/Library/Application Scripts/com.coteditor.CotEditor"
LIBDIR="$SCRIPTDIR/_lib"

printf "The script directory is:\n"
printf '"%s"\n' "${SCRIPTDIR/$HOME/\$HOME}"
printf "\n"

if [[ -d $SCRIPTDIR ]]; then
    # Top-level scripts (start with a digit)
    fd -d 1 -t f '^[0-9]' | while read -r file; do
        cp -p "$file" "$SCRIPTDIR"
    done

    mkdir -p "$LIBDIR"

    # Library scripts (don't start with a digit)
    fd -d 1 -t f '^[^0-9]' | while read -r file; do
        cp -p "$file" "$LIBDIR"
    done

    printf "These scripts were copied:\n"
    # shellcheck disable=SC2035
    eza *.sh
    printf "\n"

    printf "Check for any old files or other discrepancies:\n"
    eza -lT "$SCRIPTDIR"
else
    printf "The script directory does not exist, no scripts were copied.\n"
fi
