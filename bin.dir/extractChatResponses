#!/usr/bin/env bash

# Extracts responses from a Markdown file generated by ChatGPT Exporter
# i.e., lines from "^## Response:" to, but not including, "^## Prompt:"
#
# Usage: extractChatResponses ChatFile > Responses.md

cat <<EOF
<div style="text-align: center;">
  <h4 style="margin: 0;">Responses (only) in:</h4>
  <h4 style="margin: 0;">$1</h4>
</div>
<hr style="margin-top: 1em;">

EOF

awk '/^## Response:/ {p=1} /^## Prompt:/ {p=0} p && !/^## Prompt:/' "$1"
