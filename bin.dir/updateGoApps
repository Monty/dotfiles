#!/usr/bin/env bash
# Update known Go files from ~/go/bin
# If you install new ones, add them to the install section below

# Prevent cascading or pipe failures
set -euo pipefail

# trap and locate errors that might arise from pipefail
trap 'printf "${ERROR} at or near line %s:\n\t%s\n" \
    "$LINENO" "$BASH_COMMAND" >&2' ERR

# trap ctrl-c and SIGTERM -- call cleanup and exit
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM
#
function cleanup() {
    stty sane
    # Safe because it's created if missing
    rm -rf ~/go/releases
    printf "\n"
}

ERROR="\e[0;31m[Error]\e[0m"
WARNING="\e[0;33m[Warning]\e[0m"
INFO="\e[0;34m[Info]\e[0m"

help() {
    cat <<EOF
updateGoApps

Install or update the following Go apps in ~/go/bin:
    gocloc golangci-lint jqfmt moor rclone scc shfmt

USAGE:
    updateGoApps [OPTIONS]

OPTIONS:
    -h | --help     Show this message and exit
    -f | --force    Force an update without asking

EOF
}

# Check for options
FORCE=false
while [[ $# -gt 0 ]]; do
    case $1 in
    -h | --help)
        help
        exit 0
        ;;
    -f | --force)
        FORCE=true
        shift
        ;;
    *)
        # shellcheck disable=SC2059
        if [[ $1 == -* ]]; then
            printf "${ERROR} Unknown option: %s\n" "$1"
            printf "${INFO}  Run with --help to see available options\n"
        else
            printf "${ERROR} Invalid argument: %s\n" "$1"
            printf "${INFO}  This script does not accept positional arguments\n"
        fi
        exit 1
        ;;
    esac
done

if ! command -v go &>/dev/null; then
    # shellcheck disable=SC2059
    printf "${WARNING} Go is not installed, skipping\n"
    exit 0
fi

if [[ ! -x ~/bin/getGoAppVersions ]]; then
    # shellcheck disable=SC2059
    printf "${WARNING} ~/bin/getGoAppVersions does not exist, skipping\n"
    exit 0
fi

if [[ ! -d ~/go/bin ]]; then
    # shellcheck disable=SC2059
    printf "${WARNING} ~/go/bin does not exist, skipping\n"
    exit 0
fi

# Make a directory to use for installing releases
mkdir -p ~/go/releases
cd ~/go/releases || exit 1

currentVersion=$(go version | awk '{print $3}')
latestVersion=$(curl -s 'https://go.dev/dl/?mode=json' | jq -r '.[0].version')

printf "Your installed go version is %s, the latest is %s\n" \
    "$currentVersion" "$latestVersion"

# Check if Go version is out of date
if [[ $currentVersion != "$latestVersion" ]]; then
    cat <<EOF
Before you can proceed, either:

Update Go from https://go.dev/doc/install
  - or -
# Download the tarball
curl -OL https://go.dev/dl/$latestVersion.darwin-arm64.tar.gz

# Replace any previous Go installation with the latest
sudo rm -rf /usr/local/go
sudo tar -C /usr/local -xzf $latestVersion.darwin-arm64.tar.gz

# Remove the download tarball
rm -f $latestVersion.darwin-arm64.tar.gz

EOF
    exit 1
else
    printf "You already have the most recent version of Go\n\n"
fi

printf "==> Looking in ~/go/bin for Go apps to update:\n"

appsNeedingUpdate=$(~/bin/getGoAppVersions -u)
allApps=$(~/bin/getGoAppVersions)

# Check if any newer files were found
printf "\n%s\n\n" "$allApps"
if [[ -z $appsNeedingUpdate ]]; then
    printf "==> None of the above Go apps need updating\n"
    exit 0
else
    cat <<EOF
==> Some of the above Go apps need updating
    Doing so will update or install these apps:

$appsNeedingUpdate

EOF

    install_apps() {
        local apps_to_update="$1"

        # Install each app that needs updating
        while IFS= read -r line; do
            # Skip empty lines
            [[ -z $line ]] && continue

            # Extract just the app name (first word before whitespace)
            app=$(echo "$line" | awk '{print $1}')

            case "$app" in
            gocloc)
                printf "Installing %s...\n" "$app"
                go install github.com/hhatto/gocloc/cmd/gocloc@latest
                ;;
            golangci-lint)
                printf "Installing %s...\n" "$app"
                go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest
                ;;
            jqfmt)
                printf "Installing %s...\n" "$app"
                go install github.com/noperator/jqfmt/cmd/jqfmt@latest
                ;;
            moor)
                printf "Installing %s...\n" "$app"
                go install github.com/walles/moor/v2/cmd/moor@latest
                ;;
            scc)
                printf "Installing %s...\n" "$app"
                go install github.com/boyter/scc/v3@latest
                ;;
            shfmt)
                printf "Installing %s...\n" "$app"
                go install mvdan.cc/sh/v3/cmd/shfmt@latest
                ;;
            rclone)
                printf "Installing %s...\n" "$app"
                curl -sO https://downloads.rclone.org/rclone-current-osx-arm64.zip
                unzip -qq rclone-current-osx-arm64.zip
                cd rclone-*-osx-arm64 || exit 1
                mv rclone ~/go/bin
                cd ~/go/releases || exit 1
                rm -rf rclone-*-osx-arm64 rclone-current-osx-arm64.zip
                ;;
            *)
                printf "Unknown app: %s (skipping)\n" "$app"
                ;;
            esac
        done <<<"$apps_to_update"

        printf "\n==> All Go app versions after update\n\n"
        ~/bin/getGoAppVersions
    }

    if [[ $FORCE == true ]]; then
        printf "==> Forcing apps to be updated!\n"
        install_apps "$appsNeedingUpdate"
    else
        # If SSH session, exit rather than prompt
        # shellcheck disable=SC2059
        if [[ -n ${SSH_TTY:-} || -n ${SSH_CONNECTION:-} ]]; then
            printf "${ERROR} Unable to prompt over SSH\n"
            printf "${INFO}  Use '--force' to avoid prompting\n"
            exit 1
        fi
        printf "Update/install these Go apps? [y/N] "
        read -r -n 1 reply
        printf "\n"
        if [[ $reply =~ ^[Yy]$ ]]; then
            install_apps "$appsNeedingUpdate"
        else
            printf "==> Updates skipped\n"
        fi
    fi
fi
