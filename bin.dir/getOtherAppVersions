#!/usr/bin/env bash
# Check for updates of command line utilities

# Prevent cascading or pipe failures
set -euo pipefail

# trap ctrl-c -- call cleanup and exit
trap 'cleanup; exit 130' INT

function cleanup() {
    stty sane
    printf "\n"
}

ERROR="\e[0;31m[Error]\e[0m"
INFO="\e[0;34m[Info]\e[0m"

help() {
    cat <<EOF
getOtherAppVersions

Lists various installed applications with their --version.
Compares that with the latest versions from their GitHub repo.

USAGE:
    getOtherAppVersions [OPTIONS]

OPTIONS:
    -h, --help      Show this help message and exit
    -u, --updates   Only show apps with available updates
    -q, --quiet     Skip update checks (only shows current versions)
    -v, --verbose   Show full output and GitHub metadata

EXAMPLES:
    getOtherAppVersions         # Show all apps and their update status
    getOtherAppVersions -u      # Only show apps needing updates
    getOtherAppVersions -v      # Verbose output with full details
    getOtherAppVersions -q      # Quick check, no GitHub API calls

EOF
}

updates_only=false
verbose=false
quiet=false

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
    -h | --help)
        help
        exit
        ;;
    -u | --updates)
        updates_only=true
        shift
        ;;
    -v | --verbose)
        verbose=true
        shift
        ;;
    -q | --quiet)
        quiet=true
        shift
        ;;
    *)
        # shellcheck disable=SC2059
        if [[ $1 == -* ]]; then
            printf "${ERROR} Unknown option: %s\n" "$1"
            printf "${INFO}  Run with --help to see available options\n"
        else
            printf "${ERROR} Invalid argument: %s\n" "$1"
            printf "${INFO}  This script does not accept positional arguments\n"
        fi
        exit 1
        ;;
    esac
done

# make sure all apps are available in PATH
for each in \
    /Applications/CotEditor.app/Contents/SharedSupport/bin \
    /Applications/kitty.app/Contents/MacOS \
    $HOME/.volta/bin \
    $HOME/Library/Python/3.9/bin \
    $HOME/Projects/dart-sass \
    $HOME/Projects/nvim-macos/bin; do
    if [[ -d $each ]]; then
        # echo "### Found $each"
        if ! echo ":$PATH:" | grep -s ":$each:" >/dev/null; then
            PATH=${PATH}:$each
        fi
    fi
done

# GitHub repositories (owner/repo)
repos=(
    "kovidgoyal/kitty"
    "microsoft/playwright"
    "volta-cli/volta"
    "nodejs/node"
    "npm/cli"
    "prettier/prettier"
    "eslint/eslint"
    "tree-sitter/tree-sitter"
    "astral-sh/ruff"
    "psf/black"
    "sass/dart-sass"
    "coteditor/CotEditor"
)

# Get display name for app (override when basename isn't right)
get_display_name() {
    local repo="$1"
    case "$repo" in
    npm/cli)
        echo "npm"
        ;;
    sass/dart-sass)
        echo "sass"
        ;;
    *)
        basename "$repo"
        ;;
    esac
}

# Get latest version from GitHub
get_github_latest() {
    local repo="$1"

    # Use GITHUB_TOKEN environment variable if available
    if [[ -n ${GITHUB_TOKEN:-} ]]; then
        curl -s -H "Authorization: token $GITHUB_TOKEN" "https://api.github.com/repos/$repo/releases/latest" |
            jq -r --arg r "$repo" '"\($r) \(.tag_name) \(.published_at // "unknown" | split("T")[0])"' 2>/dev/null
    else
        curl -s "https://api.github.com/repos/$repo/releases/latest" |
            jq -r --arg r "$repo" '"\($r) \(.tag_name) \(.published_at // "unknown" | split("T")[0])"' 2>/dev/null
    fi
}

# Extract version from command output
extract_local_version() {
    local output="$1"
    # Strip optional 'v' prefix and extract first semantic version
    echo "$output" | sed 's/^v//' |
        grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1
}

# Extract version from GitHub tag
extract_github_version() {
    local tag="$1"
    # Remove 'v' prefix and extract version number
    echo "$tag" | sed 's/^v//' |
        grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1
}

# Main processing loop
for repo in "${repos[@]}"; do
    # Get current version
    current_output=""
    app_name=$(get_display_name "$repo")

    case "$repo" in
    kovidgoyal/kitty)
        if command -v kitty &>/dev/null; then
            current_output=$(kitty --version 2>&1)
        else
            if ! $quiet && ! $updates_only; then
                printf "%-25s %s\n" "$app_name" "not installed"
            fi
            continue
        fi
        ;;
    microsoft/playwright)
        if [[ -n ${WS:-} ]] && [[ -d $WS ]]; then
            cd "$WS" || continue
            if [[ -d "${HOME}/Library/Caches/ms-playwright/" ]]; then
                if command -v npx &>/dev/null; then
                    current_output=$(npx playwright --version 2>&1)
                fi
            fi
            cd - >/dev/null || true
        fi
        if [[ -z $current_output ]]; then
            if ! $quiet && ! $updates_only; then
                printf "%-25s %s\n" "$app_name" "not installed"
            fi
            continue
        fi
        ;;
    volta-cli/volta)
        if command -v volta &>/dev/null; then
            current_output=$(volta --version 2>&1)
        else
            if ! $quiet && ! $updates_only; then
                printf "%-25s %s\n" "$app_name" "not installed"
            fi
            continue
        fi
        ;;
    nodejs/node)
        if command -v node &>/dev/null; then
            current_output=$(node --version 2>&1)
        else
            if ! $quiet && ! $updates_only; then
                printf "%-25s %s\n" "$app_name" "not installed"
            fi
            continue
        fi
        ;;
    npm/cli)
        if command -v npm &>/dev/null; then
            current_output=$(npm --version 2>&1)
        else
            if ! $quiet && ! $updates_only; then
                printf "%-25s %s\n" "npm" "not installed"
            fi
            continue
        fi
        ;;
    prettier/prettier)
        if command -v prettier &>/dev/null; then
            current_output=$(prettier --version 2>&1)
        else
            if ! $quiet && ! $updates_only; then
                printf "%-25s %s\n" "$app_name" "not installed"
            fi
            continue
        fi
        ;;
    eslint/eslint)
        if command -v eslint &>/dev/null; then
            current_output=$(eslint --version 2>&1)
        else
            if ! $quiet && ! $updates_only; then
                printf "%-25s %s\n" "$app_name" "not installed"
            fi
            continue
        fi
        ;;
    tree-sitter/tree-sitter)
        if command -v tree-sitter &>/dev/null; then
            current_output=$(tree-sitter --version 2>&1)
        else
            if ! $quiet && ! $updates_only; then
                printf "%-25s %s\n" "$app_name" "not installed"
            fi
            continue
        fi
        ;;
    astral-sh/ruff)
        if command -v ruff &>/dev/null; then
            current_output=$(ruff --version 2>&1)
        else
            if ! $quiet && ! $updates_only; then
                printf "%-25s %s\n" "$app_name" "not installed"
            fi
            continue
        fi
        ;;
    psf/black)
        if command -v black &>/dev/null; then
            current_output=$(black --version 2>&1)
        else
            if ! $quiet && ! $updates_only; then
                printf "%-25s %s\n" "$app_name" "not installed"
            fi
            continue
        fi
        ;;
    sass/dart-sass)
        if command -v sass &>/dev/null; then
            current_output=$(sass --version 2>&1)
        else
            if ! $quiet && ! $updates_only; then
                printf "%-25s %s\n" "$app_name" "not installed"
            fi
            continue
        fi
        ;;
    coteditor/CotEditor)
        if command -v cot &>/dev/null; then
            current_output=$(cot --version 2>&1)
        else
            if ! $quiet && ! $updates_only; then
                printf "%-25s %s\n" "$app_name" "not installed"
            fi
            continue
        fi
        ;;
    *)
        continue
        ;;
    esac

    # Extract clean version
    current_version=$(extract_local_version "$current_output" "$repo")

    if [[ -z $current_version ]]; then
        if ! $quiet && ! $updates_only; then
            printf "%-25s %s\n" "$app_name" "version unknown"
        fi
        continue
    fi

    # Get latest version unless in quiet mode
    has_update=false
    latest_version=""
    latest_date=""

    if ! $quiet; then
        github_info=$(get_github_latest "$repo")
        if [[ -n $github_info ]]; then
            latest_tag=$(echo "$github_info" | awk '{print $2}')
            latest_date=$(echo "$github_info" | awk '{print $3}')
            latest_version=$(extract_github_version "$latest_tag")

            if [[ -n $latest_version && -n $current_version ]]; then
                if [[ $current_version != "$latest_version" ]]; then
                    has_update=true
                fi
            fi
        fi
    fi

    # If updates_only mode and no update, skip this app entirely
    if $updates_only && ! $has_update; then
        continue
    fi

    # Verbose mode: show full output (only reached if not skipped above)
    if $verbose; then
        echo "==> $app_name"
        echo "$current_output"
        if [[ -n $latest_version ]]; then
            echo ">>> Latest: $latest_version on $latest_date"
        fi
        echo
    fi

    # Show compact output (only if not verbose)
    if ! $verbose; then
        printf "%-25s %s" "$app_name" "$current_version"
        if $has_update; then
            printf " → %s available" "$latest_version"
        fi
        echo
    fi
done
