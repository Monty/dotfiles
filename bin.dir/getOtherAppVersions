#!/usr/bin/env bash
# Check for updates of command line utilities

# Prevent cascading or pipe failures
set -euo pipefail

# trap ctrl-c -- call cleanup and exit
trap 'cleanup; exit 130' INT

function cleanup() {
    stty sane
    printf "\n"
}

ERROR="\e[0;31m[Error]\e[0m"
INFO="\e[0;34m[Info]\e[0m"

help() {
    cat <<EOF
getOtherAppVersions

Lists various installed applications with their --version.
Compares that with the latest versions from their GitHub repo.

USAGE:
    getOtherAppVersions [OPTIONS]

OPTIONS:
    -h, --help      Show this help message and exit
    -u, --updates   Only show apps with available updates
    -q, --quiet     Skip update checks (only shows current versions)
    -v, --verbose   Show full output and GitHub metadata

EXAMPLES:
    getOtherAppVersions         # Show all apps and their update status
    getOtherAppVersions -u      # Only show apps needing updates
    getOtherAppVersions -v      # Verbose output with full details
    getOtherAppVersions -q      # Quick check, no GitHub API calls

EOF
}

updates_only=false
verbose=false
quiet=false

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
    -h | --help)
        help
        exit
        ;;
    -u | --updates)
        updates_only=true
        shift
        ;;
    -v | --verbose)
        verbose=true
        shift
        ;;
    -q | --quiet)
        quiet=true
        shift
        ;;
    *)
        # shellcheck disable=SC2059
        if [[ $1 == -* ]]; then
            printf "${ERROR} Unknown option: %s\n" "$1"
            printf "${INFO}  Run with --help to see available options\n"
        else
            printf "${ERROR} Invalid argument: %s\n" "$1"
            printf "${INFO}  This script does not accept positional arguments\n"
        fi
        exit 1
        ;;
    esac
done

# GitHub repositories (owner/repo)
repos=(
    "kovidgoyal/kitty"
    "microsoft/playwright"
    "volta-cli/volta"
    "nodejs/node"
    "npm/cli"
    "prettier/prettier"
    "eslint/eslint"
    "tree-sitter/tree-sitter"
    "yarnpkg/berry"
    "pnpm/pnpm"
    "astral-sh/ruff"
    "psf/black"
    "sass/dart-sass"
    "coteditor/CotEditor"
    "swiftlang/swift"
    "nicklockwood/SwiftFormat"
)

# Helper to map repo names to their local binary commands
get_binary_name() {
    local repo="$1"
    case "$repo" in
    npm/cli) echo "npm" ;;
    sass/dart-sass) echo "sass" ;;
    yarnpkg/berry) echo "yarn" ;;
    coteditor/CotEditor) echo "cot" ;;
    nicklockwood/SwiftFormat) echo "swiftformat" ;;
    *) basename "$repo" ;;
    esac
}

# Get latest version from GitHub
get_github_latest() {
    local repo="$1"
    # Use GITHUB_TOKEN environment variable if available
    if [[ -f "$HOME/.tokens" ]]; then
        # shellcheck source=/dev/null
        source "$HOME/.tokens"
    fi
    if [[ -n ${GITHUB_TOKEN:-} ]]; then
        curl -s -H "Authorization: token $GITHUB_TOKEN" "https://api.github.com/repos/$repo/releases/latest" |
            jq -r --arg r "$repo" '"\($r) \(.tag_name) \(.published_at // "unknown" | split("T")[0])"' 2>/dev/null
    else
        curl -s "https://api.github.com/repos/$repo/releases/latest" |
            jq -r --arg r "$repo" '"\($r) \(.tag_name) \(.published_at // "unknown" | split("T")[0])"' 2>/dev/null
    fi
}

# Extract version from command output
extract_local_version() {
    local output="$1"
    # Special handling for Swift
    if [[ $output == *"Apple Swift version"* ]]; then
        echo "$output" |
            grep -oE 'Apple Swift version [0-9]+\.[0-9]+\.[0-9]+' |
            grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1
        return
    fi
    # Strip optional 'v' prefix and extract first semantic version
    echo "$output" | sed 's/^v//' |
        grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1
}

# Extract version from GitHub tag
extract_github_version() {
    local tag="$1"
    # Remove 'v' prefix and extract version number
    echo "$tag" | sed 's/^v//' |
        grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1
}

# Main processing loop
for repo in "${repos[@]}"; do
    current_output=""
    app_name=$(get_binary_name "$repo")

    # Handle Swift (Special Case - only check if in Swiftly directory)
    if [[ $repo == "swiftlang/swift" ]]; then
        # Only check Swift if it's installed via Swiftly
        if [[ -x "$HOME/.swiftly/bin/swift" ]]; then
            current_output=$("$HOME/.swiftly/bin/swift" --version 2>&1 || true)
        fi

    # Handle Standard CLIs (Generic Logic)
    else
        # Check if command exists
        if command -v "$app_name" &>/dev/null; then
            current_output=$("$app_name" --version 2>&1 || true)
        fi
    fi

    # Handle missing apps or empty output
    # shellcheck disable=SC2059
    if [[ -z $current_output ]]; then
        if ! $quiet && ! $updates_only && $verbose; then
            printf "==> %s\n" "$app_name"
            printf "${INFO} Not installed\n\n"
        fi
        continue
    fi

    # Extract clean version
    current_version=$(extract_local_version "$current_output")
    if [[ -z $current_version ]]; then
        if ! $quiet && ! $updates_only; then
            printf "%-25s %s\n" "$app_name" "version unknown"
        fi
        continue
    fi

    # Get latest version unless in quiet mode
    has_update=false
    latest_version=""
    latest_date=""

    if ! $quiet; then
        github_info=$(get_github_latest "$repo")
        if [[ -n $github_info ]]; then
            latest_tag=$(echo "$github_info" | awk '{print $2}')
            latest_date=$(echo "$github_info" | awk '{print $3}')
            latest_version=$(extract_github_version "$latest_tag")

            if [[ -n $latest_version && -n $current_version ]]; then
                if [[ $current_version != "$latest_version" ]]; then
                    has_update=true
                fi
            fi
        fi
    fi

    # If updates_only mode and no update, skip this app entirely
    if $updates_only && ! $has_update; then
        continue
    fi

    # Verbose mode: show full output (only reached if not skipped above)
    if $verbose; then
        echo "==> $app_name"
        echo "$current_output"
        if [[ -n $latest_version ]]; then
            echo ">>> Latest: $latest_version on $latest_date"
        fi
        echo
    fi

    # Show compact output (only if not verbose)
    if ! $verbose; then
        printf "%-25s %s" "$app_name" "$current_version"
        if $has_update; then
            printf " → %s available" "$latest_version"
        fi
        echo
    fi
done
