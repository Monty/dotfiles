#!/usr/bin/env bash
# Get the app version of relevant files in ~/.cargo/bin

# Prevent cascading or pipe failures
set -euo pipefail

# trap and locate errors that might arise from pipefail
trap 'printf "${ERROR} at or near line %s:\n\t%s\n" \
    "$LINENO" "$BASH_COMMAND" >&2' ERR

# trap ctrl-c and SIGTERM -- call cleanup and exit
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM
#
function cleanup() {
    stty sane
    printf "\n"
}

ERROR="\e[0;31m[Error]\e[0m"
INFO="\e[0;34m[Info]\e[0m"

help() {
    cat <<EOF
getRustAppVersions

Lists installed Rust applications from ~/.cargo/bin with their
semantic versions extracted from --version output. Useful for
tracking installed tool versions.

USAGE:
    getRustAppVersions [OPTIONS]

OPTIONS:
    -h, --help      Show this help message and exit
    -u, --updates   Only show apps with available updates
    -q, --quiet     Skip update checks (only shows current versions)
    -v, --verbose   Show full --version output alongside semantic version

EXAMPLE (verbose):
    ==> tokei --version
    tokei 12.1.2 compiled with serialization support: json
    >>> Semantic version
    tokei 12.1.2

EOF
}

updates_only=false
verbose=false
quiet=false

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
    -h | --help)
        help
        exit
        ;;
    -u | --updates)
        updates_only=true
        shift
        ;;
    -v | --verbose)
        verbose=true
        shift
        ;;
    -q | --quiet)
        quiet=true
        shift
        ;;
    *)
        # shellcheck disable=SC2059
        if [[ $1 == -* ]]; then
            printf "${ERROR} Unknown option: %s\n" "$1"
            printf "${INFO}  Run with --help to see available options\n"
        else
            printf "${ERROR} Invalid argument: %s\n" "$1"
            printf "${INFO}  This script does not accept positional arguments\n"
        fi
        exit 1
        ;;
    esac
done

# Kludge for lychee or other commands needing openssl-3 dylibs
# uses dylibs from /Applications/kitty.app/Contents/Frameworks/
if [[ -z ${DYLD_LIBRARY_PATH:-} ]]; then
    export DYLD_LIBRARY_PATH="/Applications/kitty.app/Contents/Frameworks"
else
    export DYLD_LIBRARY_PATH="/Applications/kitty.app/Contents/Frameworks:$DYLD_LIBRARY_PATH"
fi
# printf "DYLD_LIBRARY_PATH = '%s'\n\n" "${DYLD_LIBRARY_PATH:-}"

# Map binary names to crate names where they differ
get_crate_name() {
    case "$1" in
    delta) echo "git-delta" ;;
    difft) echo "difftastic" ;;
    fresh) echo "fresh-editor" ;;
    fd) echo "fd-find" ;;
    hx) echo "" ;; # Helix releases on GitHub, not crates.io
    rg) echo "ripgrep" ;;
    riff) echo "riffdiff" ;;
    rip) echo "rm-improved" ;;
    tree) echo "rust_tree" ;;
    tldr) echo "tealdeer" ;;
    *) echo "$1" ;;
    esac
}

# Get latest version from appropriate source
get_latest_version() {
    local app_name="$1"
    local crate="$2"

    if [[ -z $crate ]]; then
        # Empty crate name means check GitHub instead
        local github_repo
        case "$app_name" in
        hx) github_repo="helix-editor/helix" ;;
        *)
            echo ""
            return
            ;;
        esac

        curl -s "https://api.github.com/repos/$github_repo/releases/latest" 2>/dev/null |
            jq -r '.tag_name // empty' |
            sed 's/^v//' || true # Remove 'v' prefix if present
    else
        curl -s "https://crates.io/api/v1/crates/$crate" 2>/dev/null |
            jq -r '.crate.max_stable_version // empty' || true
    fi
}

# Get latest rustc version from official Rust channel
get_latest_rustc_version() {
    curl -s "https://static.rust-lang.org/dist/channel-rust-stable.toml" 2>/dev/null |
        grep "rust-[0-9].*aarch64-apple-darwin.tar.gz" |
        grep -oE '[0-9]+\.[0-9]+\.[0-9]+' |
        head -1 || true
}

# Parse version from app output
parse_version() {
    local output="$1"
    # Try to extract semantic version (x.y.z with optional v prefix)
    # Also handle versions with only x.y
    echo "$output" | grep -oE 'v?[0-9]+\.[0-9]+(\.[0-9]+)?' |
        head -1 || true
}

# Process rustc as a special synthetic entry
process_rustc() {
    local rustup_path="$HOME/.cargo/bin/rustup"

    # Only process if rustup exists
    [[ ! -x $rustup_path ]] && return

    # Get rustc version from rustup
    version_output=$("$rustup_path" --version 2>&1)

    # Extract rustc version from the "currently active" line
    version=$(echo "$version_output" | grep "currently active.*rustc" |
        grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)

    if [[ -z $version ]]; then
        return
    fi

    has_update=false
    latest=""

    if ! $quiet; then
        latest=$(get_latest_rustc_version)

        if [[ -n $latest && $latest != "$version" ]]; then
            has_update=true
        fi
    fi

    # Skip if updates_only and no update available
    if $updates_only && ! $has_update; then
        return
    fi

    # NOW show verbose output (after determining if we should show this entry)
    if $verbose; then
        echo "=> rustc (via rustup)"
        echo "$version_output" | grep "currently active"
        echo ">>> Semantic version"
    fi

    # Show output based on mode
    if $updates_only; then
        printf "%-20s %s → %s\n" "rustc" "$version" "$latest"
    else
        printf "%-20s %s" "rustc" "$version"
        if $has_update; then
            printf " → %s available" "$latest"
        fi
        echo
    fi

    if $verbose; then
        echo
    fi
}

# Get list of executables in ~/.cargo/bin, excluding symlinks
for app in ~/.cargo/bin/*; do
    [[ -x $app ]] || continue
    [[ -L $app ]] && continue # Skip symlinks (rustup-managed)
    basename_app=$(basename "$app")

    # Skip apps managed by other crates
    [[ $basename_app == "xls2csv" ]] && continue # Managed by xls2txt
    [[ $basename_app == "uvx" ]] && continue     # Managed by uv

    # Special handling: process rustc before rustup
    if [[ $basename_app == "rustup" ]]; then
        process_rustc
    fi

    # Get version output (capture both stdout and stderr)
    version_output=$("$app" --version 2>&1)

    # Parse version
    version=$(parse_version "$version_output")
    if [[ -z $version ]]; then
        continue
    fi

    # Check for updates unless in quiet mode
    has_update=false
    latest=""

    if ! $quiet; then
        crate_name=$(get_crate_name "$basename_app")
        latest=$(get_latest_version "$basename_app" "$crate_name")

        if [[ -n $latest && $latest != "$version" ]]; then
            # Remove 'v' prefix for comparison if present
            current_ver="${version#v}"
            latest_ver="${latest#v}"

            if [[ $current_ver != "$latest_ver" ]]; then
                has_update=true
                # prettydiff binaries no longer included, pin version
                [[ $basename_app == "prettydiff" ]] && has_update=false
            fi
        fi
    fi

    # Skip if updates_only and no update available
    if $updates_only && ! $has_update; then
        continue
    fi

    # NOW show verbose output (after determining if we should show this app)
    if $verbose; then
        echo "=> $basename_app --version"
        echo "$version_output"
        echo ">>> Semantic version"
    fi

    # Show output based on mode
    if $updates_only; then
        # Only show apps with updates available
        printf "%-20s %s → %s\n" "$basename_app" "$version" "$latest"
    else
        # Show all apps, mark updates
        printf "%-20s %s" "$basename_app" "$version"
        if $has_update; then
            printf " → %s available" "$latest"
        fi
        echo
    fi

    if $verbose; then
        echo
    fi
done
