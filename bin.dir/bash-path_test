#!/usr/bin/env bash

echo "--- Bash Script PATH Report ---"
printf "%s " "$(hostname)"
date
echo "GNU bash $BASH_VERSION"
echo ""

echo "Full PATH:"
echo $PATH | tr ':' '\n'
echo ""

echo "Checking for tools:"
which -a rg || echo "rg not found"
which -a swift || echo "swift not found"
echo ""

echo "Checking for directory shortcuts:"
echo "\$XR = $XR"
