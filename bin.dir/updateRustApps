#!/usr/bin/env bash
# Update known Rust apps from ~/.cargo/bin
# If you install new ones, add them to the install_apps() function below

# Prevent cascading or pipe failures
set -euo pipefail

# trap and locate errors that might arise from pipefail
trap 'printf "${ERROR} at or near line %s:\n\t%s\n" \
    "$LINENO" "$BASH_COMMAND" >&2' ERR

# trap ctrl-c and SIGTERM -- call cleanup and exit
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM
#
function cleanup() {
    stty sane
    # Safe because it's created if missing
    rm -rf ~/.cargo/releases
    printf "\n"
}

ERROR="\e[0;31m[Error]\e[0m"
WARNING="\e[0;33m[Warning]\e[0m"
INFO="\e[0;34m[Info]\e[0m"

help() {
    cat <<EOF
updateRustApps

Install or update any Rust apps in ~/.cargo/bin

USAGE:
    updateRustApps [OPTIONS]

OPTIONS:
    -h | --help     Show this message and exit
    -f | --force    Force an update without asking (needed for SSH)

EOF
}

# Check for options
FORCE=false
while [[ $# -gt 0 ]]; do
    case $1 in
    -h | --help)
        help
        exit 0
        ;;
    -f | --force)
        FORCE=true
        shift
        ;;
    *)
        # shellcheck disable=SC2059
        if [[ $1 == -* ]]; then
            printf "${ERROR} Unknown option: %s\n" "$1"
            printf "${INFO}  Run with --help to see available options\n"
        else
            printf "${ERROR} Invalid argument: %s\n" "$1"
            printf "${INFO}  This script does not accept positional arguments\n"
        fi
        exit 1
        ;;
    esac
done

if ! command -v rustup &>/dev/null; then
    # shellcheck disable=SC2059
    printf "${WARNING} Rust is not installed\n"
    cat <<EOF

Before you can proceed, install Rust by using rustup:

Run the following in your terminal:
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh
then follow the on-screen instructions.

EOF
    exit 0
fi

if [[ ! -x ~/bin/getRustAppVersions ]]; then
    # shellcheck disable=SC2059
    printf "${WARNING} ~/bin/getRustAppVersions does not exist, skipping...\n"
    exit 0
fi

if [[ ! -d ~/.cargo/bin ]]; then
    # shellcheck disable=SC2059
    printf "${WARNING} ~/.cargo/bin does not exist, skipping...\n"
    exit 0
fi

# Make a directory to use for installing releases
mkdir -p ~/.cargo/releases
cd ~/.cargo/releases || exit 1

# Get rustc version (the actual Rust compiler version)
currentVersion=$(rustc --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' |
    head -1 || echo "unknown")

# Get latest rustc version from official Rust channel
latestVersion=$(curl -s 'https://static.rust-lang.org/dist/channel-rust-stable.toml' 2>/dev/null |
    grep "rust-[0-9].*aarch64-apple-darwin.tar.gz" |
    grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || echo "")

printf "Your installed Rust toolchain is %s, the latest is %s\n" \
    "$currentVersion" "$latestVersion"

# Check if Rust version is out of date
if [[ $currentVersion != "$latestVersion" ]]; then
    printf "It will be automatically updated via 'rustup update'\n\n"
else
    printf "You already have the most recent version of Rust\n\n"
fi

printf "==> Looking in ~/.cargo/bin for Rust apps to update:\n"

appsNeedingUpdate=$(~/bin/getRustAppVersions -u)
allApps=$(~/bin/getRustAppVersions)

# Check if any newer files were found
printf "\n%s\n\n" "$allApps"
if [[ -z $appsNeedingUpdate ]]; then
    printf "==> None of the above Rust apps need updating\n"
    exit 0
else
    cat <<EOF
==> Some of the above Rust apps need updating
    Doing so will update or install these apps:

$appsNeedingUpdate

EOF

    install_apps() {
        local apps_to_update="$1"

        # First update rustup and the rust toolchain
        printf "Updating rustup and Rust toolchain...\n"
        rustup -q update

        # Install each app that needs updating
        while IFS= read -r line; do
            # Skip empty lines
            [[ -z $line ]] && continue

            # Extract just the app name (first word before whitespace)
            app=$(echo "$line" | awk '{print $1}')

            case "$app" in
            bat)
                # Modern cat clone with syntax highlighting & git support
                printf "Installing %s...\n" "$app"
                cargo install -q --force --locked bat
                bat cache --build
                ;;
            broot)
                # Tree view and navigation for directories
                printf "Installing %s...\n" "$app"
                cargo install -q --force broot
                ;;
            czkawka_cli)
                # Find and remove duplicates, empty files, & junk
                printf "Installing %s...\n" "$app"
                cargo install -q --force czkawka_cli
                ;;
            delta)
                # Syntax-highlighting pager for git
                printf "Installing %s...\n" "$app"
                cargo install -q --force git-delta
                ;;
            diffr)
                # Word-level diff on top of unified diffs
                printf "Installing %s...\n" "$app"
                cargo install -q --force diffr
                ;;
            difft)
                # Syntax-aware structural diff
                printf "Installing %s...\n" "$app"
                cargo install -q --force difftastic
                ;;
            eza)
                # Modern ls clone with colors, icons, git status
                printf "Installing %s...\n" "$app"
                cargo install -q --force eza
                ;;
            fclones)
                # Efficiently find and remove duplicate files
                printf "Installing %s...\n" "$app"
                cargo install -q --force fclones
                ;;
            fd)
                # Simple, fast alternative to find
                printf "Installing %s...\n" "$app"
                cargo install -q --force fd-find
                ;;
            fresh)
                # Text editor with multi-cursor support
                printf "Installing %s...\n" "$app"
                printf "Can take 10 minutes. Be patient!\n"
                cargo install -q --force fresh-editor
                ;;
            hexyl)
                # Command-line hex viewer with colors
                printf "Installing %s...\n" "$app"
                cargo install -q --force hexyl
                ;;
            hx)
                # Modal text editor in terminal; build locally
                printf "Installing %s...\n" "$app"
                if [[ -d ~/Projects/helix ]]; then
                    cd ~/Projects/helix || exit 1
                    printf "Building local version...\n"
                    git pull
                    # Build optimized version
                    cargo install -q --force \
                        --profile opt \
                        --config 'build.rustflags="-C target-cpu=native"' \
                        --path helix-term \
                        --locked
                    # Ensure runtime symlink exists
                    [[ ! -L ~/.config/helix/runtime ]] &&
                        ln -s "$PWD/runtime" ~/.config/helix/runtime
                    hx --grammar fetch
                    cd - >/dev/null
                else
                    # No local helix directory, show website instructions
                    # shellcheck disable=SC2059
                    printf "${WARNING} ~/Projects/helix does not exist, skipping...\n"
                    printf "          (See https://docs.helix-editor.com/install.html)\n"
                fi
                ;;
            hyperfine)
                # Command-line benchmarking tool
                printf "Installing %s...\n" "$app"
                cargo install -q --force hyperfine
                ;;
            lsd)
                # Modern ls clone with icons and colors
                printf "Installing %s...\n" "$app"
                cargo install -q --force lsd
                ;;
            lychee)
                # Fast async link checker for Markdown/HTML
                printf "Installing %s...\n" "$app"
                # Get the latest release download URL
                download_url=$(curl -s "https://api.github.com/repos/lycheeverse/lychee/releases/latest" |
                    jq -r '.assets[] | select(.name == "lychee-arm64-macos.tar.gz") | .browser_download_url')
                curl -sL "$download_url" -o lychee-arm64-macos.tar.gz
                tar -xzf lychee-arm64-macos.tar.gz lychee
                mv lychee ~/.cargo/bin
                rm -f lychee-arm64-macos.tar.gz
                ;;
            mdbook)
                # Create online books from Markdown files
                printf "Installing %s...\n" "$app"
                cargo install -q --force mdbook
                ;;
            miniserve)
                # Simple tool to serve files/dirs over HTTP
                printf "Installing %s...\n" "$app"
                cargo install -q --force --locked miniserve
                ;;
            nu)
                # Modern shell with structured data support
                printf "Installing %s...\n" "$app"
                cargo install -q --force --locked nu
                ;;
            prettydiff)
                # Side-by-side diff with formatting
                printf "Installing %s...\n" "$app"
                cargo install -q --force prettydiff --version 0.6.4
                ;;
            qsv)
                # Fast CSV command line toolkit (replaces xsv)
                printf "Installing %s...\n" "$app"
                qsv -U
                ;;
            rg)
                # Extremely fast and better alternative to grep
                printf "Installing %s...\n" "$app"
                cargo install -q --force ripgrep
                ;;
            rip)
                # Safer rm command with recovery
                printf "Installing %s...\n" "$app"
                cargo install -q --force rm-improved
                ;;
            rustc)
                # rustc is updated via rustup, skip individual install
                printf "Skipping %s (updated via rustup)...\n" "$app"
                ;;
            rustup)
                # rustup, has already run, skip individual install
                printf "Skipping %s (already updated)...\n" "$app"
                ;;
            sd)
                # Change all occurences of a string in a file
                printf "Installing %s...\n" "$app"
                cargo install -q --force sd
                ;;
            stdrename)
                # Batch rename files using patterns
                printf "Installing %s...\n" "$app"
                cargo install -q --force stdrename
                ;;
            stylua)
                # Lua code formatter
                printf "Installing %s...\n" "$app"
                cargo install -q --force stylua
                ;;
            tldr)
                # Fast tldr client, i.e., simplified man pages
                printf "Installing %s...\n" "$app"
                cargo install -q --force tealdeer
                tldr --update
                ;;
            tokei)
                # Count code lines by language
                printf "Installing %s...\n" "$app"
                cargo install -q --force tokei
                ;;
            tree)
                # Rust implementation of Linux tree
                printf "Installing %s...\n" "$app"
                cargo install -q --force rust_tree
                ;;
            uv)
                # Extremely fast Python package and project manager
                printf "Installing %s...\n" "$app"
                cargo install -q --force --locked uv
                ;;
            vivid)
                # Generator for the LS_COLORS environment variable
                printf "Installing %s...\n" "$app"
                if [[ -d ~/Projects/vivid ]]; then
                    cd ~/Projects/vivid || exit 1
                    printf "Building local version...\n"
                    git pull
                    # Build customized version
                    cargo build --release
                    # Copy to local Rust directory
                    cp -p target/release/vivid ~/.cargo/bin/vivid
                    cd - >/dev/null
                else
                    # No local vivid directory, use cargo install
                    cargo install -q --force vivid
                fi
                ;;
            xls2txt)
                # Convert .ods or .xls files to .tsv or .csv filesd
                printf "Installing %s...\n" "$app"
                cargo install -q --force xls2txt
                ;;
            xsv)
                # Fast CSV command line toolkit
                printf "Installing %s...\n" "$app"
                cargo install -q --force xsv
                ;;
            zeitfetch)
                # Neofetch clone written in rust
                printf "Installing %s...\n" "$app"
                cargo install -q --force zeitfetch
                ;;
            zet)
                # Set operations on files: union/intersection/difference
                printf "Installing %s...\n" "$app"
                cargo install -q --force zet
                ;;
            *)
                printf "Unknown app: %s (skipping)\n" "$app"
                ;;
            esac
        done <<<"$apps_to_update"

        printf "\n==> All Rust app versions after update\n\n"
        ~/bin/getRustAppVersions
    }

    if [[ $FORCE == true ]]; then
        printf "==> Forcing apps to be updated!\n"
        install_apps "$appsNeedingUpdate"
    else
        # If SSH session, exit rather than prompt
        # shellcheck disable=SC2059
        if [[ -n ${SSH_TTY:-} || -n ${SSH_CONNECTION:-} ]]; then
            printf "${ERROR} Unable to prompt over SSH\n"
            printf "${INFO}  Use '--force' to avoid prompting\n"
            exit 1
        fi
        printf "Update/install these Rust apps? [y/N] "
        read -r -n 1 reply
        printf "\n"
        if [[ $reply =~ ^[Yy]$ ]]; then
            install_apps "$appsNeedingUpdate"
        else
            printf "==> Updates skipped\n"
        fi
    fi
fi
