#!/usr/bin/env bash
# Clean up and de-dupe the output of newEpisodes

# shellcheck disable=SC2154     # References to $NE and $WS

# Prevent cascading or pipe failures
set -euo pipefail

# trap and locate errors that might arise from pipefail
trap 'printf "${ERROR} at or near line %s:\n\t%s\n" \
    "$LINENO" "$BASH_COMMAND" >&2' ERR

# trap ctrl-c and SIGTERM -- call cleanup and exit
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM
#
function cleanup() {
    stty sane
    printf "\n"
}

ERROR="\e[0;31m[Error]\e[0m"
INFO="\e[0;34m[Info]\e[0m"

DATE_ID="-$(date +%y%m%d)"
OUTFILE="newEpisodes$DATE_ID.txt"
MD_FILE="newEpisodes$DATE_ID.md"
EXCLUDE_FILE="rg_newEpisodes.rgx"
# The "SINCE" date is derived from OFFSET after arg parsing
# This default OFFSET may be overridden by --date
OFFSET="-1w"

help() {
    cat <<EOF
saveNewEpisodes

Clean up and de-dupe the output of \$WS/newEpisodes.sh
Generate $OUTFILE and $MD_FILE
Save them in \$NE, and condensed versions in ~/Desktop

USAGE:
    saveNewEpisodes [OPTIONS]

OPTIONS:
    -h | --help     Print this message.
    -d | --date     Date offset in date -v format (default: -1w)

EXAMPLES:
    saveNewEpisodes
    saveNewEpisodes --date -4d
EOF
}

# Check for options
while [[ $# -gt 0 ]]; do
    case $1 in
    -h | --help)
        help
        exit
        ;;
    -d | --date)
        shift
        if [[ $# -eq 0 ]]; then
            # shellcheck disable=SC2059
            printf "${ERROR} --date requires an argument (e.g. -2w, -3d)\n" >&2
            exit 1
        fi
        OFFSET="$1"
        shift
        ;;
    *)
        # shellcheck disable=SC2059
        if [[ $1 == -* ]]; then
            printf "${ERROR} Unknown option: %s\n" "$1"
            printf "${INFO}  Run with --help to see available options\n"
        else
            printf "${ERROR} Invalid argument: %s\n" "$1"
            printf "${INFO}  This script does not accept positional arguments\n"
        fi
        exit 1
        ;;
    esac
done

cd "$NE" || exit

# Derive date string from final OFFSET value
SINCE="$(date -v "$OFFSET" +%d-%b-%y)"

printf "==> File written to %s\n\n" "$OUTFILE"

# Make sure the permanent EXCLUDE_FILE is the most current file
touch "$EXCLUDE_FILE"
printf "==> Applying exclusions from %s\n\n" "$EXCLUDE_FILE"
"$WS"/newEpisodes.sh | rg -v -f "$EXCLUDE_FILE" >"$OUTFILE"

# Deduplicate and update metadata (no prompts!)
python3 tv_dedup.py "$OUTFILE"

# Compress the cleaned version
"$WS"/compress_newEpisodes.py "$OUTFILE" >~/Desktop/"$OUTFILE"

awk -f convertEpisodesToMarkdown.awk -v SINCE="$SINCE" \
    "$OUTFILE" >"$MD_FILE"
awk -f convertEpisodesToMarkdown.awk -v SINCE="$SINCE" \
    "$HOME/Desktop/$OUTFILE" >~/Desktop/"$MD_FILE"
