#!/usr/bin/env bash
# Update the git repositories in any subdirectories

# Prevent cascading or pipe failures
set -euo pipefail

# trap and locate errors that might arise from pipefail
trap 'printf "${ERROR} at or near line %s:\n\t%s\n" \
    "$LINENO" "$BASH_COMMAND" >&2' ERR

# trap ctrl-c and SIGTERM -- call cleanup and exit
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM
#
function cleanup() {
    stty sane
    printf "\n"
}

ERROR="\e[0;31m[Error]\e[0m"
WARNING="\e[0;33m[Warning]\e[0m"
INFO="\e[0;34m[Info]\e[0m"

help() {
    cat <<EOF
pullAll

Updates git repositories in subdirectories by pulling changes from
their remotes. Only pulls when the local branch is behind the remote
(fast-forward updates).

BEHAVIOR:
    - Searches for .git directories in subdirectories
    - Skips repositories without remotes
    - Only pulls when local branch is behind (safe, no conflicts)
    - Shows interactive confirmation before running

USAGE:
    pullAll [OPTIONS]

OPTIONS:
    -h, --help      Show this help message and exit
    -d, --dry-run   Preview repositories that would be updated
    -v, --verbose   Show all repositories checked (not just updated ones)
    -d[2-9]         Limit subdirectory search depth (e.g., -d3 for 3 levels)

EOF
}

# So we can retrieve version info from any public repo
if [[ -f ~/.tokens ]]; then
    # shellcheck source=/dev/null
    source ~/.tokens
fi

# Check for options
DRY_RUN=false
VERBOSE=false
FD_ARGS=()
while [[ $# -gt 0 ]]; do
    case $1 in
    -h | --help)
        help
        exit
        ;;
    -d | --dry-run)
        DRY_RUN=true
        shift
        ;;
    -v | --verbose)
        VERBOSE=true
        shift
        ;;
    -d[2-9])
        depth="${1#-d}" # Strip off the -d prefix
        FD_ARGS=("-d" "$depth")
        shift
        ;;
    *)
        printf "==> $ERROR Invalid argument: '%s'\n" "$1" >&2
        exit 1
        ;;
    esac
done

# Helper function to execute command unless in dry-run mode
maybe_run() {
    if [[ $DRY_RUN == false ]]; then
        "$@"
    fi
}

# shellcheck disable=SC2059
[[ $DRY_RUN == true ]] && printf "==> $INFO Starting dry run...\n\n"

# Explain before running
help

read -r -n 1 -s -p "Hit any key to continue, '^C' to quit. "
echo ""

# Directories to skip entirely (will show one message per directory)
skip_dirs=("helix/runtime/grammars")

# Track which skip directories we've already reported (as a string)
reported_skips=""

savedDirectory="$PWD"
for i in $(fd -HI --glob ${FD_ARGS[@]+"${FD_ARGS[@]}"} -td -p '**/.git' -X ls -1d '{//}'); do
    cd "${i}" || exit

    # Check if this repo is in a skip directory
    skip_this=false
    for skip_dir in "${skip_dirs[@]}"; do
        if [[ ${i} == *"/${skip_dir}/"* ]]; then
            if [[ ! $reported_skips =~ :$skip_dir: ]]; then
                printf "==> $INFO Skipping all repos in %s/\n" \
                    "${skip_dir}"
                reported_skips="${reported_skips}:${skip_dir}:"
            fi
            skip_this=true
            break
        fi
    done

    if [[ $skip_this == true ]]; then
        cd "$savedDirectory" || exit
        continue
    fi

    if [[ -e .git/config ]]; then
        # Check if repo has a remote configured
        if ! git remote | grep -q .; then
            printf "==> $WARNING No remote in %s\n" "${i}"
            cd "$savedDirectory" || exit
            continue
        fi
        [[ $VERBOSE == true ]] && printf "==> Checking %s\n" "${i}"

        # Update the URL temporarily for my repos
        remote_url=$(git remote get-url origin 2>/dev/null || echo "")
        using_token=false

        if [[ -n $GITHUB_TOKEN ]] &&
            [[ $remote_url =~ github\.com[:/]Monty/ ]]; then
            # Extract the repo path from various URL formats
            if [[ $remote_url =~ github\.com[:/](.+)(\.git)?$ ]]; then
                # Remove .git ifpresent
                repo_path="${BASH_REMATCH[1]%.git}"
                # Temporarily set the URL to use the token
                git remote set-url origin \
                    "https://${GITHUB_TOKEN}@github.com/${repo_path}.git"
                using_token=true
            fi
        fi

        # Fetch updates silently to check if there are changes
        git fetch --quiet 2>/dev/null || true

        # Check if local branch is behind remote
        LOCAL=$(git rev-parse @ 2>/dev/null)
        REMOTE=$(git rev-parse '@{u}' 2>/dev/null || echo "")
        BASE=$(git merge-base @ '@{u}' 2>/dev/null || echo "")

        # Only pull if we have a remote and local is behind remote
        if [[ -n $REMOTE ]] && [[ -n $BASE ]] &&
            [[ $LOCAL != "$REMOTE" ]] &&
            [[ $LOCAL == "$BASE" ]]; then
            printf "==> Pulling %s\n" "${i}"
            maybe_run git pull
        fi

        # Restore original URL if we changed it
        if [[ $using_token == true ]]; then
            git remote set-url origin "$remote_url"
        fi
    fi
    cd "$savedDirectory" || exit
done
