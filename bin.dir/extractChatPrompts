#!/usr/bin/env bash

# Extracts prompts from a Markdown file generated by ChatGPT Exporter
# i.e., lines from "^## Prompt:" to, but not including, "^## Response:"
#
# Usage: extractChatPrompts ChatFile > Prompts.md

cat <<EOF
<div style="text-align: center;">
  <h4 style="margin: 0;">Prompts (only) in:</h4>
  <h4 style="margin: 0;">$1</h4>
</div>
<hr style="margin-top: 1em;">

EOF

awk '/^## Prompt:/ {p=1} /^## Response:/ {p=0} p && !/^## Response:/' "$1"
