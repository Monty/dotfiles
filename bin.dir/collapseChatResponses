#!/usr/bin/env bash

# Collapse "Responses" in a chat downloaded by ChatGPT Exporter
# leaving only "Prompts" immediately visible.
#
# Surround '## Response' sections with
#   "<details><summary>Click to view Response:</summary>"
#   [Response content]
#   </details>

# Prevent cascading or pipe failures
set -euo pipefail

ERROR='\033[31m[Error]\033[0m'

# Only process one file
if [[ $# -ne 1 ]]; then
    printf "%b Must have exactly one argument.\n" "$ERROR" >/dev/stderr
    printf "\tUsage: %s <file> > <revisedfile>\n" \
        "$(basename "$0")" >/dev/stderr
    exit 1
fi

file="$1"

if [[ ! -f $file ]]; then
    printf "%b File '%s' does not exist.\n" "$ERROR" "$file" >&2
    exit 1
fi

if grep -q 'Click to view Response' "$file"; then
    printf "%b '%s' has already been processed.\n" \
        "$ERROR" "$file" >"/dev/stderr"
    exit
fi

cat <<EOF
<h3 style="text-align:center;">Generated File Warning</h3>

> This file was automatically generated by the export program
> credited at the end. It may contain unescaped or unintended
> Markdown characters (e.g., asterisks, underscores, dashes)
> that cause rendering issues. You may need to review and
> edit this file to ensure it displays correctly.
EOF

awk '
/^\*\*Link:\*\* / { next }

/^\*\*User:\*\* / { next }

/^## Prompt:/ {
    promptLinesFound++

    if (promptLinesFound > 1) { print "</details>\n" }
}

/^## Response:/ {
    responseLinesFound++
    print "<details><summary>Click to view Response:</summary>\n"
}

/^Powered by \[/ { print "</details>\n" }

{ print }

END {
    printf(\
        "==> Found %d Prompts, %d Responses\n",
        promptLinesFound,
        responseLinesFound\
    ) > "/dev/stderr"
}
' "$file"
