" Zacess Deep Contrast Light
" generated by scripts/build.mjs from palette/zacess.json, do not edit by hand
" needs Vim 8.2 or later with true colour: termguicolors in a terminal, or gVim or MacVim

set background=light
hi clear
if exists('syntax_on')
  syntax reset
endif
let g:colors_name = 'zacess-deep-contrast-light'

if !has('gui_running') && !(has('termguicolors') && &termguicolors)
  echohl WarningMsg | echomsg 'zacess-deep-contrast-light needs true colour: set termguicolors' | echohl None
endif

