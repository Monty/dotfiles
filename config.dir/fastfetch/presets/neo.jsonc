{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 2
    }
  },
  "modules": [
    {
      "type": "title",
      "key": "System details for",
      "format": "{user-name-colored}@{host-name-colored}"
    },
    {
      "type": "datetime",
      "key": "Date",
      "format": "{day-in-month}-{month-name-short}-{year}"
    },
    {
      "type": "separator",
      "times": 65
    },
    {
      "type": "host",
      "key": "Mac Model"
    },
    {
      "type": "command",
      "key": "Serial Number",
      "text": "system_profiler SPHardwareDataType | awk '/ Serial Number/ {print $4}'"
    },
    {
      "type": "command",
      "key": "Hardware UUID",
      "text": "system_profiler SPHardwareDataType | awk '/ Hardware UUID/ {print $3}'"
    },
    {
      "type": "command",
      "key": "System Firmware",
      "text": "system_profiler SPHardwareDataType | awk '/ System Firmware / {print $4}'"
    },
    {
      "type": "command",
      "key": "MAC Address (en0)",
      "text": "ifconfig | grep -A 2 ^en0 | awk '/ether/ {print $2}'"
    },
    {
      "type": "command",
      "key": "MAC Address (en1)",
      "text": "ifconfig | grep -A 2 ^en1 | awk '/ether/ {print $2}'"
    },
    {
      "type": "separator",
      "times": 3
    },
    {
      "type": "command",
      "key": "Computer",
      "text": "sysctl -n hw.model"
    },
    {
      "type": "cpu",
      "showPeCoreCount": true,
      "temp": true
    },
    "gpu",
    "memory",
    "disk",
    {
      "type": "command",
      "key": "Resolution",
      "text": "system_profiler SPDisplaysDataType | grep Resolution: | tr -s ' ' | cut -d ' ' -f3-"
    },
    "btrfs",
    {
      "type": "battery",
      "temp": true
    },
    "poweradapter",
    {
      "type": "separator",
      "times": 3
    },
    "os",
    "kernel",
    "shell",
    "terminal",
    "terminalfont",
    "locale",
    {
      "type": "separator",
      "times": 3
    },
    {
      "type": "command",
      "key": "Go",
      "text": "/usr/local/go/bin/go version"
    },
    {
      "type": "command",
      "key": "Kitty",
      "text": "/Applications/kitty.app/Contents/MacOS/kitty -v"
    },
    {
      "type": "command",
      "key": "Node",
      "text": "$HOME/.volta/bin/node --version",
      "format": "node {1}"
    },
    {
      "type": "command",
      "key": "Rust",
      "text": "rustc --version"
    },
    {
      "type": "separator",
      "times": 3
    },
    {
      "type": "localip",
      "showIpv6": true,
      "showMac": true,
      "showAllIps": true
    },
    {
      "type": "publicip",
      "timeout": 1000
    },
    "uptime",
    "users",
    {
      "type": "separator",
      "times": 65
    },
    "version"
  ]
}
